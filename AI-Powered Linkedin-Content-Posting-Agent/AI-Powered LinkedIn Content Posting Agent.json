      "id": "ab34a6d6-3895-407a-bff9-8d31c8233626",
      "name": "Upload Design to LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1248,
        -96
      ],
      "notes": "Uploads the binary property named data to the uploadUrl returned by LinkedIn. LinkedIn's upload URL is time-limited."
    },
    {
      "parameters": {
        "jsCode": "const details = $('Set Post Details').first().json;\nconst content = $('Format LinkedIn Content').first().json;\nconst imageInit = $('LinkedIn Initialize Image Upload').first().json;\n\nreturn [{\n  json: {\n    linkedin_person_urn: details.linkedin_person_urn,\n    linkedin_access_token: details.linkedin_access_token,\n    linkedin_api_version: details.linkedin_api_version,\n    imageUrn: imageInit.value.image,\n    image_alt_text: details.image_alt_text,\n    linkedin_post_text: content.linkedinContent\n  }\n}];"
      },
      "id": "f8e701a1-92f1-417c-b4c3-6c5c7aaa4540",
      "name": "Prepare LinkedIn Post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        -544
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/rest/posts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linkedInOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Linkedin-Version",
              "value": "202608"
            },
            {
              "name": "X-Restli-Protocol-Version",
              "value": "2.0.0"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    author: $('Prepare LinkedIn Post').first().json.linkedin_person_urn,\n    commentary: $('Prepare LinkedIn Post').first().json.linkedin_post_text,\n    visibility: \"PUBLIC\",\n    distribution: {\n      feedDistribution: \"MAIN_FEED\",\n      targetEntities: [],\n      thirdPartyDistributionChannels: []\n    },\n    content: {\n      media: {\n        id: $('Prepare LinkedIn Post').first().json.imageUrn,\n        altText: $('Prepare LinkedIn Post').first().json.image_alt_text\n      }\n    },\n    lifecycleState: \"PUBLISHED\"\n  }\n}}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "85c9e7f6-b6d3-4043-8a5d-4af88811b1b0",
      "name": "Publish Post to LinkedIn",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1744,
        -176
      ],
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "hW3xmHcBxYKf58u9",
          "name": "LinkedIn account"
        }
      },
      "notes": "Creates the published public member post using the current LinkedIn Posts API. A successful request returns HTTP 201 and the post ID in the x-restli-id response header."
    },
    {
      "parameters": {
        "jsCode": "const source = $('Prepare LinkedIn Post').first();\nconst postId =\n  $json?.headers?.['x-restli-id'] ??\n  $json?.headers?.['X-RestLi-Id'] ??\n  $json?.['x-restli-id'] ??\n  null;\nreturn [{\n  json: {\n    status: 'Success',\n    message: 'Your AI-generated LinkedIn post was published successfully.',\n    post_id: postId,\n    image_urn: source.json.imageUrn,\n    caption: source.json.caption,\n    hashtags: source.json.hashtags,\n    linkedin_post_text: source.json.linkedin_post_text\n  }\n}];"
      },
      "id": "2fc2f9e7-ce73-4884-a229-f460e3dd5745",
      "name": "LinkedIn Post Success",
      "type": "n8n-nodes-base.code",
