          "id": "hW3xmHcBxYKf58u9",
          "name": "LinkedIn account"
        }
      },
      "notes": "Uses the current LinkedIn Images API initializeUpload action. The member URN must match the authenticated LinkedIn member."
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $('LinkedIn Initialize Image Upload').first().json.value.uploadUrl }}",
