      "id": "9ad1ce89-539b-455f-bd88-69bef90a87a4",
      "name": "Get Design Image",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        304,
        -704
      ],
      "notes": "Configure image_file_path in Set Post Details to a JPG or PNG file path that is readable by the n8n runtime. If n8n runs in Docker, the image must be in a directory mounted into the container (for example /n8n_files). The binary property created by this node is named data."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\n  model: \"qwen3:8b\",\n  prompt: \"Write a professional LinkedIn post about my Nova Magazine editorial design project. Mention that I am a Graphic Designer and AI Automation Specialist, and that this post was prepared and published through an AI-powered automation workflow built with n8n. Emphasize that I am learning, experiencing, making mistakes, and improving, and that every workflow I build is another step forward. Keep the tone authentic, professional, and suitable for learning in public. Do not invent client results, engagement statistics, or claims that are not provided. Include these hashtags exactly: #RiseWithTechCrush #Tech4Africans #LearningWithTechCrush #AIAutomation #n8n #Automation #WorkflowAutomation #LearningInPublic #GraphicDesign #EditorialDesign #MagazineDesign #Typography #VisualDesign. Return only the LinkedIn post text, with no explanation.\",\n  stream: false\n}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "cf8f6b3a-a4f0-421b-a4a3-53fa25c5e9eb",
      "name": "Ollama AI Content Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        256,
        -160
      ],
      "notes": "Requires Ollama to be reachable from the n8n runtime. If n8n is in Docker, localhost usually points to the container; use host.docker.internal or the appropriate Docker host/service name instead."
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Try to find the AI-generated content\nlet content =\n  input.text ||\n  input.response ||\n  input.content ||\n  input.output ||\n  input.message?.content ||\n  '';\n\nif (typeof content !== 'string') {\n  content = JSON.stringify(content);\n}\n\n// Clean unnecessary formatting\ncontent = content\n  .replace(/^```[\\s\\S]*?\\n/, '')\n  .replace(/\\n```$/, '')\n  .trim();\n\nreturn [\n  {\n    json: {\n      linkedinContent: content\n    }\n  }\n];"
      },
      "id": "6e85ce46-b7a3-4699-aebb-e7312403bd75",
      "name": "Format LinkedIn Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        -560
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/rest/images?action=initializeUpload",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linkedInOAuth2Api",
